{
  "$schema": "https://opencode.ai/config.json",
  "model": "ipad/local",
  "agents": {
    "ipad-code": {
      "description": "Programación con herramientas de OpenCode y el modelo del iPad",
      "mode": "primary",
      "model": "ipad/local",
      "system": "Lee las reglas del proyecto y localiza el código relevante. Carga una skill si corresponde a la tarea. Usa las herramientas disponibles y comprueba sus resultados antes de afirmar que un cambio se realizó.",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "codecrisol-diagnostico", "effect": "allow" },
        { "action": "skill", "resource": "codecrisol-cambio-acotado", "effect": "allow" },
        { "action": "skill", "resource": "codecrisol-revision-diff", "effect": "allow" },
        { "action": "external_directory", "resource": "*", "effect": "ask" },
        { "action": "edit", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "*", "effect": "ask" }
      ]
    },
    "ipad-chat": {
      "description": "Conversación de texto con el modelo del iPad",
      "mode": "primary",
      "system": "Responde en español a la última petición del usuario. La respuesta es texto de conversación.",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "execute", "resource": "*", "effect": "deny" }
      ]
    }
  },
  "providers": {
    "ipad": {
      "name": "CodeCrisol (iPad)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://192.168.1.50:8080/v1"
      },
      "body": {
        "tool_choice": "none",
        "crucible_opencode_text": true
      },
      "models": {
        "local": {
          "name": "Modelo cargado en el iPad",
          "capabilities": {
            "tools": false,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 4096,
            "output": 500
          }
        }
      }
    }
  }
}
